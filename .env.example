# Base de données PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/tempo?schema=public"

# IA — Gemini (gratuit) via la couche compatible OpenAI
GEMINI_API_KEY="AIza..."        # clé Google AI Studio (aistudio.google.com/apikey)
GEMINI_MODEL="gemini-2.5-flash" # optionnel ; ex. gemini-3.5-flash
# (Ancienne option OpenAI — plus utilisée par défaut)
# OPENAI_API_KEY="sk-..."

# Auth (mode solo : un simple secret suffit)
AUTH_SECRET="genere-un-secret-long-et-aleatoire"

# Cron quotidien (Vercel envoie "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET="un-autre-secret-pour-proteger-le-cron"

# Admin (seed sans terminal via POST /api/admin/seed)
ADMIN_SECRET="encore-un-secret-pour-le-seed"

# Tokens des sources connectées — À CHIFFRER au repos en prod
# (en solo tu peux les coller ici pour démarrer, puis migrer vers du chiffré)
STRAVA_ACCESS_TOKEN=""
STRAVA_REFRESH_TOKEN=""

# MCP GetFast (analyse + push parcours Garmin)
GETFAST_MCP_URL="https://getfast.ai/mcp"
GETFAST_TOKEN="" # token OAuth GetFast (pour POST /api/sync)
