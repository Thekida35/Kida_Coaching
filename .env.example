# Base de données PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/kida?schema=public"

# Accès à l'app
APP_CODE="123456"               # code d'accès 4 à 6 chiffres (écran de connexion)
AUTH_SECRET="un-secret-long-et-aleatoire"
CRON_SECRET="un-autre-secret"   # Vercel Cron envoie "Authorization: Bearer <CRON_SECRET>"
APP_URL="https://kida-coaching.vercel.app"  # domaine public (retour Strava)

# Coach IA — Gemini via la couche compatible OpenAI
GEMINI_API_KEY="AIza..."
GEMINI_MODEL="gemini-2.5-flash"  # optionnel

# Strava (strava.com/settings/api)
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""

# Notifications push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
